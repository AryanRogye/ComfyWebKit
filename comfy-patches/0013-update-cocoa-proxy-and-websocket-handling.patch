+        RetainPtr protectedSession = session;
+        if (CheckedPtr networkSession = _session)
+            networkSession->replacedSessionDidBecomeInvalid(protectedSession.get());
+        return;
+    }
+#endif
     ASSERT(!_sessionWrapper);
 }
 
