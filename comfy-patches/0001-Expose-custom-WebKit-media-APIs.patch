From a2ded6e8ae15ed832834699043bc733b6c56a150 Mon Sep 17 00:00:00 2001
From: AryanRogye <aryan.rogye@gmail.com>
Date: Tue, 6 Oct 2026 20:38:29 -0500
Subject: [PATCH 01/11] Expose custom WebKit media APIs

---
 .gitignore                                    |  7 ++++
 Source/WebKit/UIProcess/API/Cocoa/WKWebView.h | 32 +++++++++++++++++--
 .../UIProcess/API/Cocoa/WKWebViewPrivate.h    |  1 -
 .../API/Cocoa/WKWebViewPrivateForTesting.h    |  1 +
 .../UIProcess/API/Cocoa/WKWebViewTesting.mm   | 21 ++++++++++++
 5 files changed, 58 insertions(+), 4 deletions(-)

diff --git a/.gitignore b/.gitignore
index 0c1ec57461f8..3e9838b9188c 100644
--- a/.gitignore
+++ b/.gitignore
@@ -97,3 +97,10 @@ CLAUDE.md
 *.profraw
 *.pas_stats.jsonl
 
+# Ignore libpas builds and log-outputs
+/Source/bmalloc/build*/
+
+# logs
+build-webcore.log
+build.log
+build-release.log
diff --git a/Source/WebKit/UIProcess/API/Cocoa/WKWebView.h b/Source/WebKit/UIProcess/API/Cocoa/WKWebView.h
index faa7f2c8a77b..886f7e8d5a86 100644
--- a/Source/WebKit/UIProcess/API/Cocoa/WKWebView.h
+++ b/Source/WebKit/UIProcess/API/Cocoa/WKWebView.h
@@ -212,11 +212,29 @@ typedef NS_ENUM(NSInteger, WKFullscreenState) {
 @property (nonatomic, readonly) BOOL hasOnlySecureContent;
 
 /*! @abstract A SecTrustRef for the currently committed navigation.
- @discussion @link WKWebView @/link is key-value observing (KVO) compliant 
+ @discussion @link WKWebView @/link is key-value observing (KVO) compliant
  for this property.
  */
 @property (nonatomic, readonly, nullable) SecTrustRef serverTrust WK_API_AVAILABLE(macos(10.12), ios(10.0));
 
+/*! @abstract A SecTrustRef with a 2-QWAC for the currently committed navigation.
+ @discussion Since a separate fetch is needed to get the 2-QWAC data, this becomes available
+ after the serverTrust.  It will only become available if the server has a valid 2-QWAC.
+ This property is key-value observing (KVO) compliant.
+ */
+@property (nonatomic, readonly, nullable) SecTrustRef qualifiedServerTrust WK_API_AVAILABLE(macos(WK_MAC_TBA), ios(WK_IOS_TBA), visionos(WK_XROS_TBA));
+
+/*! @abstract The process identifier (pid) of the web content process currently
+ hosting this web view's page.
+ @discussion This is the WebContent process, not the GPU or Networking process,
+ so work such as media decoding and audio output may be attributed to a
+ different pid. The value can change over the life of the web view, for example
+ after a process swap on cross-site navigation or after the web content process
+ terminates and is relaunched, so read it each time you need it instead of
+ caching it. This property is not key-value observing (KVO) compliant.
+ */
+@property (nonatomic, readonly) pid_t _webProcessIdentifier;
+
 /*! @abstract A Boolean value indicating whether there is a back item in
  the back-forward list that can be navigated to.
  @discussion @link WKWebView @/link is key-value observing (KVO) compliant
@@ -435,8 +453,8 @@ typedef NS_ENUM(NSInteger, WKFullscreenState) {
 /*! @abstract Get a snapshot for the visible viewport of WKWebView.
  @param snapshotConfiguration An object that specifies how the snapshot is configured.
  @param completionHandler A block to invoke when the snapshot is ready.
- @discussion If the WKSnapshotConfiguration is nil, the method will snapshot the bounds of the 
- WKWebView and create an image that is the width of the bounds of the WKWebView and scaled to the 
+ @discussion If the WKSnapshotConfiguration is nil, the method will snapshot the bounds of the
+ WKWebView and create an image that is the width of the bounds of the WKWebView and scaled to the
  device scale. The completionHandler is passed the image of the viewport contents or an error.
  */
 #if TARGET_OS_IPHONE
@@ -787,6 +805,14 @@ typedef NS_OPTIONS(NSUInteger, WKWebViewDataType) {
 
 @end
 
+@interface WKWebView (NowPlaying)
+
+- (void)_requestActiveNowPlayingSessionInfo:(void(^)(BOOL, BOOL, NSString *, double, double, NSInteger, NSUInteger))callback;
+- (void)_requestActiveNowPlayingSessionInfoWithPlayback:(void(^)(BOOL, BOOL, BOOL, NSString *, NSString *, double, double, double, NSInteger, NSUInteger))callback;
+
+@end
+
+
 WK_API_AVAILABLE(macos(10.15.4))
 @interface WKWebView (WKNSTextFinderClient) <NSTextFinderClient>
 @end
diff --git a/Source/WebKit/UIProcess/API/Cocoa/WKWebViewPrivate.h b/Source/WebKit/UIProcess/API/Cocoa/WKWebViewPrivate.h
index 7fad74f7f2ac..74fe96438f49 100644
--- a/Source/WebKit/UIProcess/API/Cocoa/WKWebViewPrivate.h
+++ b/Source/WebKit/UIProcess/API/Cocoa/WKWebViewPrivate.h
@@ -222,7 +222,6 @@ typedef NS_ENUM(NSInteger, _WKImmediateActionType) {
 @property (nonatomic, readonly, getter=_isPlayingAudio) BOOL _playingAudio WK_API_AVAILABLE(macos(10.13.4), ios(11.3));
 @property (nonatomic, setter=_setUserContentExtensionsEnabled:) BOOL _userContentExtensionsEnabled WK_API_AVAILABLE(macos(10.11), ios(9.0));
 
-@property (nonatomic, readonly) pid_t _webProcessIdentifier;
 @property (nonatomic, readonly) pid_t _provisionalWebProcessIdentifier WK_API_AVAILABLE(macos(10.14.4), ios(12.2));
 @property (nonatomic, readonly) pid_t _gpuProcessIdentifier WK_API_AVAILABLE(macos(13.0), ios(16.0));
 @property (nonatomic, readonly) pid_t _modelProcessIdentifier WK_API_AVAILABLE(macos(15.0), ios(18.0), visionos(2.0));
diff --git a/Source/WebKit/UIProcess/API/Cocoa/WKWebViewPrivateForTesting.h b/Source/WebKit/UIProcess/API/Cocoa/WKWebViewPrivateForTesting.h
index 6392c6df1e3a..d3f88b9c3f6e 100644
--- a/Source/WebKit/UIProcess/API/Cocoa/WKWebViewPrivateForTesting.h
+++ b/Source/WebKit/UIProcess/API/Cocoa/WKWebViewPrivateForTesting.h
@@ -78,6 +78,7 @@ typedef NSVisualEffectView _WKPlatformVisualEffectView;
 - (NSDictionary *)_contentsOfUserInterfaceItem:(NSString *)userInterfaceItem;
 
 - (void)_requestActiveNowPlayingSessionInfo:(void(^)(BOOL, BOOL, NSString*, double, double, NSInteger, NSUInteger))callback;
+- (void)_requestActiveNowPlayingSessionInfoWithPlayback:(void(^)(BOOL, BOOL, BOOL, NSString *, NSString *, double, double, double, NSInteger, NSUInteger))callback;
 - (void)_setNowPlayingMetadataObserver:(void(^)(_WKNowPlayingMetadata *))observer;
 
 - (void)_doAfterNextPresentationUpdateWithoutWaitingForAnimatedResizeForTesting:(void (^)(void))updateBlock;
diff --git a/Source/WebKit/UIProcess/API/Cocoa/WKWebViewTesting.mm b/Source/WebKit/UIProcess/API/Cocoa/WKWebViewTesting.mm
index 414930f8424c..f522233c319e 100644
--- a/Source/WebKit/UIProcess/API/Cocoa/WKWebViewTesting.mm
+++ b/Source/WebKit/UIProcess/API/Cocoa/WKWebViewTesting.mm
@@ -321,6 +321,27 @@ static void dumpCALayer(TextStream& ts, CALayer *layer, bool traverse)
     });
 }
 
+- (void)_requestActiveNowPlayingSessionInfoWithPlayback:(void(^)(BOOL, BOOL, BOOL, NSString *, NSString *, double, double, double, NSInteger, NSUInteger))callback
+{
+    if (!_page) {
+        callback(NO, NO, NO, @"", @"", std::numeric_limits<double>::quiet_NaN(), std::numeric_limits<double>::quiet_NaN(), std::numeric_limits<double>::quiet_NaN(), 0, 0);
+        return;
+    }
+    _page->requestActiveNowPlayingSessionInfo([handler = makeBlockPtr(callback)] (bool registeredAsNowPlayingApplication, WebCore::NowPlayingInfo&& nowPlayingInfo) {
+        handler(
+                nowPlayingInfo.allowsNowPlayingControlsVisibility,
+                registeredAsNowPlayingApplication,
+                nowPlayingInfo.isPlaying,
+                nowPlayingInfo.metadata.title.createNSString().get(),
+                nowPlayingInfo.metadata.artwork ? nowPlayingInfo.metadata.artwork->src.createNSString().get() : @"",
+                nowPlayingInfo.rate,
+                nowPlayingInfo.duration,
+                nowPlayingInfo.currentTime,
+                nowPlayingInfo.uniqueIdentifier ? nowPlayingInfo.uniqueIdentifier->toUInt64() : 0,
+                nowPlayingInfo.updateTime);
+    });
+}
+
 - (void)_setNowPlayingMetadataObserver:(void(^)(_WKNowPlayingMetadata *))observer
 {
     RefPtr page = _page;
-- 
2.46.2

