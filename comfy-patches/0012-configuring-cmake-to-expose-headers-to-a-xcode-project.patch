+list(REMOVE_ITEM WebKit_SWIFT_CLANG_INCLUDE_DIRS "${WebKit_FRAMEWORK_HEADERS_DIR}")
+
+# Public API imports must resolve through the framework module, not header maps
+# or the unmodularized forwarding directory (which assigns them to WebKit_Private).
+function(_webkit_mac_swift_framework_includes)
+    get_target_property(_includes WebKit INCLUDE_DIRECTORIES)
+    set(_filtered)
+    foreach (_include IN LISTS _includes)
+        if (_include STREQUAL WebKit_FRAMEWORK_HEADERS_DIR OR _include MATCHES "WebKit-(framework|project)-headers\\.hmap$")
+            list(APPEND _filtered "$<$<NOT:$<COMPILE_LANGUAGE:Swift>>:${_include}>")
+        else ()
+            list(APPEND _filtered "${_include}")
+        endif ()
+    endforeach ()
+    set_property(TARGET WebKit PROPERTY INCLUDE_DIRECTORIES "${_filtered}")
+endfunction()
+cmake_language(DEFER CALL _webkit_mac_swift_framework_includes)
 
