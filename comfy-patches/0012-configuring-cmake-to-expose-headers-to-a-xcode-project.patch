Subject: [PATCH] configuring cmake to expose headers to a xcode project

---
diff --git a/Source/JavaScriptCore/PlatformMac.cmake b/Source/JavaScriptCore/PlatformMac.cmake
index 276f6eda318fa01f2eb5571a514d6a1d769523d8..fd1c58e8da1785d2ddb1bda4b90fdfcd8d7cffd3 100644
--- a/Source/JavaScriptCore/PlatformMac.cmake
+++ b/Source/JavaScriptCore/PlatformMac.cmake
@@ -13,3 +13,23 @@ list(APPEND JavaScriptCore_PUBLIC_FRAMEWORK_HEADERS
     API/JSVirtualMachine.h
     API/JavaScriptCore.h
 )
+
+# WebKit's public legacy headers import JavaScriptCore. A sibling framework
+# without its own Headers directory shadows the SDK framework but cannot be
+# imported by an external client.
+set(_jsc_framework "${CMAKE_LIBRARY_OUTPUT_DIRECTORY}/JavaScriptCore.framework")
+file(MAKE_DIRECTORY "${_jsc_framework}/Versions/A/Headers" "${_jsc_framework}/Versions/A/Modules")
+file(CREATE_LINK "A" "${_jsc_framework}/Versions/Current" SYMBOLIC)
+foreach (_directory Headers Modules)
+    file(CREATE_LINK "Versions/Current/${_directory}" "${_jsc_framework}/${_directory}" SYMBOLIC)
+endforeach ()
+set(_jsc_client_headers ${JavaScriptCore_PUBLIC_FRAMEWORK_HEADERS})
+list(FILTER _jsc_client_headers EXCLUDE REGEX "(Private|JSCallbackFunction)\\.h$")
+WEBKIT_COPY_FILES(JavaScriptCore_StageFrameworkHeaders
+    DESTINATION "${_jsc_framework}/Versions/A/Headers"
+    FILES ${_jsc_client_headers}
+    FLATTENED NO_SYMLINK
+)
+configure_file("${JAVASCRIPTCORE_DIR}/JavaScriptCore.modulemap"
+    "${_jsc_framework}/Versions/A/Modules/module.modulemap" COPYONLY)
+add_dependencies(JavaScriptCore JavaScriptCore_StageFrameworkHeaders)
