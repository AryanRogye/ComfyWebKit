diff --git a/Source/WebKit/PlatformMacFrameworkHeaders.cmake b/Source/WebKit/PlatformMacFrameworkHeaders.cmake
new file mode 100644
index 0000000000000000000000000000000000000000..3d873709b2d04eda8d5843610772f2f843c4f5e8
--- /dev/null
+++ b/Source/WebKit/PlatformMacFrameworkHeaders.cmake
@@ -0,0 +1,116 @@
+# Match Xcode's public/private header visibility rather than putting the whole
+# build-tree forwarding directory (which includes implementation headers) in the
+# public Clang module's umbrella directory.
+set(_wk_framework "${CMAKE_LIBRARY_OUTPUT_DIRECTORY}/WebKit.framework")
+set(_wk_framework_version "${_wk_framework}/Versions/A")
+file(MAKE_DIRECTORY "${_wk_framework_version}/Headers" "${_wk_framework_version}/PrivateHeaders")
+file(CREATE_LINK "A" "${_wk_framework}/Versions/Current" SYMBOLIC)
+foreach (_directory Headers PrivateHeaders)
+    file(CREATE_LINK "Versions/Current/${_directory}" "${_wk_framework}/${_directory}" SYMBOLIC)
+endforeach ()
+
+file(STRINGS "${WEBKIT_DIR}/WebKit.xcodeproj/project.pbxproj" _wk_public_entries
+    REGEX "in Headers.*ATTRIBUTES = \\(Public,")
+set(_wk_public_names)
+foreach (_entry IN LISTS _wk_public_entries)
+    string(REGEX MATCH "/\\* ([^*]+) in Headers \\*/" _match "${_entry}")
+    list(APPEND _wk_public_names "${CMAKE_MATCH_1}")
+endforeach ()
+set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
+    "${WEBKIT_DIR}/WebKit.xcodeproj/project.pbxproj"
+    "${WEBKIT_DIR}/Modules/OSX_Private.modulemap"
+    "${WEBKIT_DIR}/MigratedHeaders-output.xcfilelist")
+
+set(_wk_header_manifest "")
+set(_wk_header_inputs)
+set(_wk_header_outputs)
+foreach (_header IN LISTS WebKit_PUBLIC_FRAMEWORK_HEADERS WebKit_PRIVATE_FRAMEWORK_HEADERS)
+    cmake_path(ABSOLUTE_PATH _header BASE_DIRECTORY "${WEBKIT_DIR}" NORMALIZE OUTPUT_VARIABLE _source)
+    cmake_path(GET _header FILENAME _name)
+    if (_name IN_LIST _wk_public_names OR _name STREQUAL "WebKitLegacy.h")
+        set(_visibility Headers)
+    else ()
+        set(_visibility PrivateHeaders)
+    endif ()
+    set(_destination "${_wk_framework_version}/${_visibility}/${_name}")
+    string(APPEND _wk_header_manifest "copy|${_source}|${_destination}\n")
+    list(APPEND _wk_header_inputs "${_source}")
+    list(APPEND _wk_header_outputs "${_destination}")
+endforeach ()
+
+# Explicit private submodules must have headers even when the corresponding
+# implementation is not enabled on this platform.
+file(STRINGS "${WEBKIT_DIR}/Modules/OSX_Private.modulemap" _wk_private_module_headers REGEX "header \"")
+file(GLOB_RECURSE _wk_source_headers "${WEBKIT_DIR}/*.h")
+foreach (_entry IN LISTS _wk_private_module_headers)
+    string(REGEX MATCH "header \"([^\"]+)\"" _match "${_entry}")
+    set(_name "${CMAKE_MATCH_1}")
+    set(_destination "${_wk_framework_version}/PrivateHeaders/${_name}")
+    if (_destination IN_LIST _wk_header_outputs)
+        continue ()
+    endif ()
+    foreach (_source IN LISTS _wk_source_headers)
+        cmake_path(GET _source FILENAME _source_name)
+        if (_source_name STREQUAL _name)
+            string(APPEND _wk_header_manifest "copy|${_source}|${_destination}\n")
+            list(APPEND _wk_header_inputs "${_source}")
+            list(APPEND _wk_header_outputs "${_destination}")
+            break()
+        endif ()
+    endforeach ()
+endforeach ()
+
+# The Mac umbrella imports <WebKit/DOM.h>, <WebKit/WebView.h>, etc.
+# Migrate the legacy headers with the same WebCore import/export adjustments as
+# WebKitLegacy/scripts/migrate-header-rule, then forward from WebKit's bundle.
+get_property(_wk_legacy_sources GLOBAL PROPERTY WebKitLegacy_MAC_HEADER_SOURCES)
+set(_wk_legacy_framework "${CMAKE_LIBRARY_OUTPUT_DIRECTORY}/WebKitLegacy.framework")
+file(MAKE_DIRECTORY "${_wk_legacy_framework}/Versions/A/Headers")
+file(CREATE_LINK "A" "${_wk_legacy_framework}/Versions/Current" SYMBOLIC)
+file(CREATE_LINK "Versions/Current/Headers" "${_wk_legacy_framework}/Headers" SYMBOLIC)
+file(STRINGS "${WEBKIT_DIR}/MigratedHeaders-output.xcfilelist" _wk_migrated_outputs)
+foreach (_source IN LISTS _wk_legacy_sources)
+    # The legacy forwarding list still contains removed NPAPI headers.
+    if (NOT EXISTS "${_source}")
+        continue ()
+    endif ()
+    cmake_path(GET _source FILENAME _name)
+    set(_legacy_destination "${_wk_legacy_framework}/Versions/A/Headers/${_name}")
+    string(APPEND _wk_header_manifest "legacy|${_source}|${_legacy_destination}\n")
+    list(APPEND _wk_header_inputs "${_source}")
+    list(APPEND _wk_header_outputs "${_legacy_destination}")
+    foreach (_output IN LISTS _wk_migrated_outputs)
+        cmake_path(GET _output FILENAME _output_name)
+        if (_output_name STREQUAL _name)
+            if (_output MATCHES "PRIVATE_HEADERS_FOLDER_PATH")
+                set(_visibility PrivateHeaders)
+            else ()
+                set(_visibility Headers)
+            endif ()
+            set(_destination "${_wk_framework_version}/${_visibility}/${_name}")
+            string(APPEND _wk_header_manifest "forward|${_name}|${_destination}\n")
+            list(APPEND _wk_header_outputs "${_destination}")
+        endif ()
+    endforeach ()
+endforeach ()
+set(_wk_header_manifest_path "${CMAKE_CURRENT_BINARY_DIR}/MacFrameworkHeaders.txt")
+file(CONFIGURE OUTPUT "${_wk_header_manifest_path}" CONTENT "${_wk_header_manifest}" @ONLY)
+set(_wk_header_staging_script "${CMAKE_SOURCE_DIR}/Source/cmake/StageMacWebKitHeaders.cmake")
+list(REMOVE_DUPLICATES _wk_header_inputs)
+list(REMOVE_DUPLICATES _wk_header_outputs)
+add_custom_command(
+    OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/MacFrameworkHeaders.stamp"
+    BYPRODUCTS ${_wk_header_outputs}
+    COMMAND ${CMAKE_COMMAND} -DMANIFEST=${_wk_header_manifest_path} -P "${_wk_header_staging_script}"
+    COMMAND ${CMAKE_COMMAND} -E touch "${CMAKE_CURRENT_BINARY_DIR}/MacFrameworkHeaders.stamp"
+    DEPENDS ${_wk_header_inputs} "${_wk_header_manifest_path}" "${_wk_header_staging_script}"
+    COMMENT "Staging macOS WebKit framework headers"
+    VERBATIM
+)
+add_custom_target(WebKit_StageFrameworkHeaders DEPENDS "${CMAKE_CURRENT_BINARY_DIR}/MacFrameworkHeaders.stamp")
+add_dependencies(WebKit WebKit_StageFrameworkHeaders)
+add_dependencies(WebKit_StageFrameworkHeaders JavaScriptCore_StageFrameworkHeaders)
+# The standalone Swift-to-C++ header emission runs before the main framework
+# compilation, and also inherits -import-underlying-module.
+cmake_language(DEFER CALL add_dependencies WebKit_SwiftCxxHeader WebKit_StageFrameworkHeaders)
+cmake_language(DEFER CALL add_dependencies WebKit_SwiftGeneratedDeps WebKit_StageFrameworkHeaders)
