diff --git a/Source/WebKitLegacy/PlatformMac.cmake b/Source/WebKitLegacy/PlatformMac.cmake
index 47919738fb1df514f9dc6566f2d35ddfb12ef57b..e202c53b9b9614c19f554518357d753f83783eca 100644
--- a/Source/WebKitLegacy/PlatformMac.cmake
+++ b/Source/WebKitLegacy/PlatformMac.cmake
@@ -1,5 +1,10 @@
 include(PlatformCocoa.cmake)
 
+# WebCore force-loads PAL and exports its symbols. Linking the archive here
+# embeds a second copy of its Objective-C classes, including WebPanel.
+list(REMOVE_ITEM WebKitLegacy_FRAMEWORKS PAL)
+list(REMOVE_ITEM WebKitLegacy_PRIVATE_LIBRARIES PAL)
+
 find_library(APPLICATIONSERVICES_LIBRARY ApplicationServices)
 find_library(QUARTZ_LIBRARY Quartz)
 find_library(SECURITYINTERFACE_LIBRARY SecurityInterface)
@@ -451,6 +456,15 @@ set(WebKitLegacy_LEGACY_FORWARDING_HEADERS_FILES
 # Add these to the public header map.
 set(WebKitLegacy_PRIVATE_FRAMEWORK_HEADERS ${WebKitLegacy_LEGACY_FORWARDING_HEADERS_FILES})
 
+# WebKit's public umbrella also exposes the legacy API. Keep the source paths
+# available to its framework staging step (sibling directories have separate scope).
+set(_webkit_legacy_header_sources)
+foreach (_header IN LISTS WebKitLegacy_LEGACY_FORWARDING_HEADERS_FILES)
+    cmake_path(ABSOLUTE_PATH _header BASE_DIRECTORY "${WEBKITLEGACY_DIR}" NORMALIZE OUTPUT_VARIABLE _source)
+    list(APPEND _webkit_legacy_header_sources "${_source}")
+endforeach ()
+set_property(GLOBAL PROPERTY WebKitLegacy_MAC_HEADER_SOURCES "${_webkit_legacy_header_sources}")
+
 if (USE_HEADER_MAPS)
     WEBKIT_WRITE_HEADER_MAP(WebKit
         DESTINATION ${CMAKE_CURRENT_BINARY_DIR}/WebKit-forwarding-headers.hmap
diff --git a/Source/cmake/StageMacWebKitHeaders.cmake b/Source/cmake/StageMacWebKitHeaders.cmake
new file mode 100644
index 0000000000000000000000000000000000000000..24d98060d1b978ccd33f9212a56513a2a9aa8343
--- /dev/null
+++ b/Source/cmake/StageMacWebKitHeaders.cmake
@@ -0,0 +1,58 @@
+# Manifest entries: copy|source|destination, legacy|source|destination, or
+# forward|legacy-header-name|destination. Do not write through old symlinks.
+file(STRINGS "${MANIFEST}" _entries)
+set(_destinations)
+foreach (_entry IN LISTS _entries)
+    string(REPLACE "|" ";" _fields "${_entry}")
+    list(GET _fields 2 _destination)
+    list(APPEND _destinations "${_destination}")
+endforeach ()
+foreach (_entry IN LISTS _entries)
+    string(REPLACE "|" ";" _fields "${_entry}")
+    list(GET _fields 0 _mode)
+    list(GET _fields 1 _source)
+    list(GET _fields 2 _destination)
+    # A header's visibility can change when the Xcode header phase changes.
+    # Do not leave an obsolete copy for Clang to infer as another submodule.
+    if (_destination MATCHES "WebKit\\.framework/Versions/A/Headers/")
+        string(REPLACE "/Headers/" "/PrivateHeaders/" _other_destination "${_destination}")
+    elseif (_destination MATCHES "WebKit\\.framework/Versions/A/PrivateHeaders/")
+        string(REPLACE "/PrivateHeaders/" "/Headers/" _other_destination "${_destination}")
+    else ()
+        set(_other_destination "")
+    endif ()
+    if (_other_destination AND NOT _other_destination IN_LIST _destinations)
+        file(REMOVE "${_other_destination}")
+    endif ()
+    # Use the same file identity as the build-tree forwarding headers. Swift
+    # imports both layouts when compiling the public and private Clang modules;
+    # separate copies defeat #pragma once and redeclare Objective-C classes.
+    if (_mode STREQUAL "copy")
+        if (IS_SYMLINK "${_destination}")
+            file(READ_SYMLINK "${_destination}" _existing_source)
+            if (_existing_source STREQUAL _source)
+                continue ()
+            endif ()
+        endif ()
+        file(REMOVE "${_destination}")
+        get_filename_component(_directory "${_destination}" DIRECTORY)
+        file(MAKE_DIRECTORY "${_directory}")
+        file(CREATE_LINK "${_source}" "${_destination}" SYMBOLIC)
+        continue ()
+    endif ()
+    if (_mode STREQUAL "forward")
+        set(_contents "#import <WebKitLegacy/${_source}>\n")
+    else ()
+        file(READ "${_source}" _contents)
+        if (_mode STREQUAL "legacy")
+            string(REPLACE "<WebCore/" "<WebKitLegacy/" _contents "${_contents}")
+            string(REGEX REPLACE "(^|\n)( *)WEBCORE_EXPORT " "\\1\\2" _contents "${_contents}")
+        endif ()
+    endif ()
+    if (IS_SYMLINK "${_destination}")
+        file(REMOVE "${_destination}")
+    endif ()
+    get_filename_component(_directory "${_destination}" DIRECTORY)
+    file(MAKE_DIRECTORY "${_directory}")
+    file(CONFIGURE OUTPUT "${_destination}" CONTENT "${_contents}" @ONLY)
+endforeach ()
diff --git a/Source/cmake/WebKitSwiftPrewarm.cmake b/Source/cmake/WebKitSwiftPrewarm.cmake
index 8b76b1e08972ab1e9ec6d6735ff4f440b4407c78..f6e2391ec97bbee685fbe9ee3223efd64cb18a9a 100644
--- a/Source/cmake/WebKitSwiftPrewarm.cmake
+++ b/Source/cmake/WebKitSwiftPrewarm.cmake
@@ -10,7 +10,9 @@ function(WEBKIT_ADD_SWIFT_PREWARM _consumer _swift_source)
     add_library(${_prewarm} OBJECT "${_swift_source}")
 
     get_target_property(_opts ${_consumer} COMPILE_OPTIONS)
-    list(FILTER _opts EXCLUDE REGEX "-emit-clang-header-path")
+    # The prewarmer has its own module name and must not import the consumer's
+    # underlying Objective-C module or overwrite its generated interfaces.
+    list(FILTER _opts EXCLUDE REGEX "-import-underlying-module|-emit-(clang-header|module-interface|private-module-interface)(-path)?")
     target_compile_options(${_prewarm} PRIVATE ${_opts})
 
     get_target_property(_consumer_bindir ${_consumer} BINARY_DIR)
